    "threshold": 0.6,
    "max_side": 640,
    "threads": 8,
    "validation_file": "data/fire_smoke_validation.json"
  },
  "person_detection": {
    "backend": "damoyolo",
    "model_dir": "models/person/damoyolo-human",
    "python": ".venv/bin/python",
    "threshold": 0.5,
    "max_side": 640,
    "threads": 8,
    "validation_file": "data/person_detection_validation.json"
  }
