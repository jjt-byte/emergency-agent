{
  "model_path": "models/qwen2.5-3b/qwen2.5-3b-instruct-q4_k_m.gguf",
  "llama_cli": "vendor/llama.cpp/build-cpu/bin/llama-completion",
  "vision_python": ".venv/bin/python",
  "runtime_python": ".venv/bin/python",
  "vision_model": "models/ssd_300.cix",
  "cpu_affinity": "0,1,6-11",
  "threads": 8,
  "agent": {"enabled": true, "max_rounds": 3},
